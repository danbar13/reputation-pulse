# ReputationPulse AI - Live Scraping & Extraction Environment Configuration

# Google Places API (New) Key for live Google Maps ratings, review counts, and review snippets
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# SerpApi Key for live TripAdvisor, Booking.com, Yelp, Facebook, and Trustpilot review data
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini API Key for AI qualitative review synthesis and operational action items
GEMINI_API_KEY=your_gemini_api_key_here

# Master toggle for live real-world scraping (set to true to enable live APIs, false for simulation mode)
ENABLE_LIVE_SCRAPING=true
